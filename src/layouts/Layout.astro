---
import '@fontsource-variable/onest';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
	title: string;
	description: string;
}

const {description, title } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />

		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>

	</head>
<body class="min-h-screen bg-fixed bg-no-repeat bg-cover 
bg-[radial-gradient(125%_125%_at_50%_0%,#000_40%,#4f46e5_100%)]">



  <Header />

<main class="flex-1 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto w-full">
  <slot />
</main>


  <Footer />
</body>


</html>
<style is:global>
	:root {
		color-scheme: light dark;

	}
	html {

		font-family: 'Onest Variable',system-ui, sans-serif;

	}
	body {
		background: hsl(var(--b2) / var(--tw-bg-opacity));
		display: flex;
		flex-direction: column;
		
		min-height: 100vh;
	}

</style>
