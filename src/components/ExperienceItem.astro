---
import LinkInline from "./LinkInline.astro"

interface Props {
  title: string
  company: string
  description: string
  link?: string
  date: string
}

const { title, company, description, link, date } = Astro.props
---

<div
  class="relative mx-6 md:mx-12 pb-16 grid 
  before:absolute before:left-[-40px] before:h-full 
  before:border-l before:border-white/10 
  before:content-[''] md:grid-cols-5 md:gap-10"
>
  <!-- Columna izquierda -->
  <div class="relative md:col-span-2">
    <div class="sticky top-24">
      <!-- Punto timeline -->
      <span class="absolute -left-[38px] top-2 w-3 h-3 rounded-full bg-indigo-400 shadow-lg shadow-indigo-500/50"></span>

      <h3 class="text-2xl font-semibold text-white">
        {title}
      </h3>

      <h4 class="text-indigo-400/90 font-medium">
        {company}
      </h4>

      <time class="text-sm text-white/50">
        {date}
      </time>
    </div>
  </div>

  <!-- Columna derecha -->
  <div class="flex flex-col gap-3 text-white/70 md:col-span-3 leading-relaxed">
    <p>{description}</p>

    {
      link && (
        <LinkInline
          href={link}
          class="text-indigo-400 hover:text-indigo-300 transition-colors"
        >
          Saber más →
        </LinkInline>
      )
    }
  </div>
</div>
