---
const THEMES = [
  { name: "Light", icon: "sun", value: "light" },
  { name: "Dark", icon: "moon", value: "dark" },
  { name: "System", icon: "system", value: "system" }
];
---

<div class="relative" id="theme-selector">
  <!-- Botón principal con icono dinámico -->
  <button
    id="theme-toggle-btn"
    class="flex items-center justify-center w-9 h-9 rounded-lg
           hover:bg-gray-200 dark:hover:bg-gray-800
           transition-colors duration-200
           text-gray-700 dark:text-gray-300"
    aria-label="Cambiar tema"
    aria-haspopup="menu"
    aria-expanded="false"
  >
    <!-- Los iconos se muestran/ocultan vía CSS -->
    <svg id="theme-icon-light" class="theme-icon w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" 
            d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
    </svg>
    
    <svg id="theme-icon-dark" class="theme-icon w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" 
            d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
    </svg>
    
    <svg id="theme-icon-system" class="theme-icon w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" 
            d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
    </svg>
  </button>

  <!-- Menú desplegable -->
  <div
    id="themes-menu"
    class="absolute hidden top-12 right-0 min-w-[140px] py-1.5
           bg-white/90 dark:bg-gray-900/90 
           backdrop-blur-md backdrop-saturate-150
           rounded-lg shadow-xl
           border border-gray-200/50 dark:border-gray-700/50
           z-50"
    role="menu"
    aria-labelledby="theme-toggle-btn"
  >
    {THEMES.map((theme) => (
      <button
        data-theme={theme.value}
        class="theme-option w-full px-3 py-2 text-left text-sm
               flex items-center gap-2.5
               text-gray-700 dark:text-gray-300
               hover:bg-indigo-50 dark:hover:bg-indigo-950/30
               hover:text-indigo-600 dark:hover:text-indigo-400
               transition-colors duration-150
               first:rounded-t-lg last:rounded-b-lg"
        role="menuitem"
      >
        <!-- Icono del tema -->
        <span class="w-5 h-5 flex items-center justify-center">
          {theme.icon === 'sun' && (
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
            </svg>
          )}
          {theme.icon === 'moon' && (
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
            </svg>
          )}
          {theme.icon === 'system' && (
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          )}
        </span>
        
        <span class="flex-1">{theme.name}</span>
        
        <!-- Checkmark del tema activo -->
        <span class="theme-checkmark hidden text-indigo-600 dark:text-indigo-400">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
          </svg>
        </span>
      </button>
    ))}
  </div>
</div>

<style>
  .theme-icon {
    transition: opacity 0.2s ease;
  }
  
  #themes-menu[data-open="true"] {
    display: block;
    animation: slideDown 0.15s ease-out;
  }

  @keyframes slideDown {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Tema activo en el botón */
  [data-theme-active="light"] #theme-icon-light,
  [data-theme-active="dark"] #theme-icon-dark,
  [data-theme-active="system"] #theme-icon-system {
    display: block;
  }

  [data-theme-active="light"] #theme-icon-dark,
  [data-theme-active="light"] #theme-icon-system,
  [data-theme-active="dark"] #theme-icon-light,
  [data-theme-active="dark"] #theme-icon-system,
  [data-theme-active="system"] #theme-icon-light,
  [data-theme-active="system"] #theme-icon-dark {
    display: none;
  }
</style>


</script>