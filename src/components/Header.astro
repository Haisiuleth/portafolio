---
// Header.astro (versión final: desktop original + móvil mejorado)
interface Props {
  hideOnScroll?: boolean;
  variant?: "default" | "minimal";
}
const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const { hideOnScroll = true, variant = "default" } = Astro.props;

interface NavItem {
  title: string;
  label: string;
  url: string;
  isExternal?: boolean;
}

const navItems: NavItem[] = [
  {
    title: "Inicio",
    label: "inicio",
    url: "/",
  },
  {
    title: "Experiencia",
    label: "experiencia",
    url: "/#experiencia",
  },
  {
    title: "Proyectos",
    label: "proyectos",
    url: "/#proyectos",
  },
  {
    title: "Sobre mí",
    label: "sobre-mi",
    url: "/#sobre-mi",
  },
  {
    title: "Contacto",
    label: "contacto",
    url: "mailto:haisiuleth@gmail.com",
    isExternal: true,
  },
];
---

<header
  class:list={[
    "flex justify-between items-center py-4 w-full max-w-[1120px] mx-auto px-4 md:px-6 transition-all duration-300",
    hideOnScroll && "header-scroll",
    variant === "minimal" && "py-3",
  ]}
>
  <!-- Logo / Foto -->
  <a href="/" class="flex-shrink-0" aria-label="Ir al inicio">
    <img
      class="rounded-full w-12 h-12 object-cover ring-2 ring-indigo-400/30 hover:ring-indigo-400 transition-all"
     src={`${base}profile.jpeg`}
      alt="Haisiuleth Photo"
      loading="eager"
    />
  </a>

  <nav
    class="hidden md:flex items-center gap-x-8 lg:gap-x-10"
    aria-label="Navegación principal"
  >
    {navItems.map((item) => (
      <a
        href={item.url}
        class:list={[
          "text-gray-700 dark:text-gray-300 hover:text-indigo-600 dark:hover:text-indigo-400",
          "font-medium transition-colors duration-200 text-sm lg:text-base",
          "relative after:absolute after:bottom-[-4px] after:left-0 after:w-0 after:h-[2px]",
          "after:bg-indigo-600 dark:after:bg-indigo-400 after:transition-all after:duration-300",
          "hover:after:w-full",
        ]}
        {...(item.isExternal && {
          target: "_blank",
          rel: "noopener noreferrer",
        })}
      >
        {item.title}
      </a>
    ))}
  </nav>

 
<button
  class="md:hidden p-2 rounded-lg hover:bg-gray-200 dark:hover:bg-gray-800 transition-colors text-gray-900 dark:text-gray-100"
  id="menu-toggle"
  aria-label="Abrir menú"
  aria-expanded="false"
>
  <svg
    class="w-6 h-6"
    fill="none"
    stroke="currentColor"
    viewBox="0 0 24 24"
  >
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      stroke-width="2"
      d="M4 6h16M4 12h16M4 18h16"
    />
  </svg>
</button>
</header>


<div
  id="mobile-menu"
  class="fixed inset-0 z-50 md:hidden transition-transform duration-300 ease-out-cubic transform translate-x-full"
  hidden
>
  <!-- Fondo oscuro con blur  -->
  <div id="menu-overlay" class="absolute inset-0 bg-black/60 backdrop-blur-sm"></div>

  <!-- Panel lateral (fondo oscuro/gris oscuro, sin blanco) -->
  <div class="absolute right-0 top-0 h-full w-72 bg-gray-900 dark:bg-gray-950 shadow-2xl rounded-l-2xl overflow-hidden flex flex-col border-l border-gray-800">
    
    <!-- Cabecera del menú con avatar y nombre (tonos oscuros) -->
    <div class="p-6 border-b border-gray-800">
      <div class="flex items-center gap-3">
        <img
         src={`${base}profile.jpeg`}
          alt="Haisiuleth"
          class="w-12 h-12 rounded-full object-cover ring-2 ring-indigo-500/50"
        />
        <div>
          <h3 class="font-semibold text-white">Haisiuleth</h3>
          <p class="text-sm text-gray-400">Portafolio</p>
        </div>
      </div>
      
      <!-- Botón de cierre (X) con estilo oscuro -->
      <button
        id="close-menu"
        class="absolute top-6 right-6 p-2 rounded-full hover:bg-gray-800 transition-colors"
        aria-label="Cerrar menú"
      >
        <svg class="w-5 h-5 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Navegación con iconos (colores oscuros, indigo en hover) -->
    <nav class="flex-1 overflow-y-auto py-4 px-2" aria-label="Navegación móvil">
      <ul class="space-y-1">
        {navItems.map((item) => (
          <li>
            <a
              href={item.url}
              class="flex items-center gap-3 px-4 py-3 text-gray-300 text-base rounded-xl hover:bg-indigo-600/10 hover:text-indigo-400 transition-all duration-200 group"
              {...(item.isExternal && {
                target: "_blank",
                rel: "noopener noreferrer",
              })}
            >
              <!-- Iconos con tu estilo -->
              <span class="w-5 h-5 flex items-center justify-center text-gray-500 group-hover:text-indigo-400">
                {item.label === 'inicio' && (
                  <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
                  </svg>
                )}
                {item.label === 'experiencia' && (
                  <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                  </svg>
                )}
                {item.label === 'proyectos' && (
                  <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z" />
                  </svg>
                )}
                {item.label === 'sobre-mi' && (
                  <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                  </svg>
                )}
                {item.label === 'contacto' && (
                  <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                  </svg>
                )}
              </span>
              <span class="flex-1 font-medium">{item.title}</span>
              {item.isExternal && (
                <span class="text-xs text-gray-500">↗</span>
              )}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Footer con email (opcional, en tonos oscuros) -->
    <div class="p-6 border-t border-gray-800">
      <p class="text-sm text-gray-400 mb-3">Contacto rápido</p>
      <a href="mailto:haisiuleth@gmail.com" class="flex items-center gap-2 text-sm text-gray-300 hover:text-indigo-400 transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
        </svg>
        haisiuleth@gmail.com
      </a>
    </div>
  </div>
</div>

<style is:global>
  /* Animación scroll (igual que antes) */
  .header-scroll {
    animation: blur linear both;
    animation-timeline: scroll();
    animation-range: 0 200px;
    position: sticky;
    top: 0;
    z-index: 40;
  }

  @keyframes blur {
    0% {
      background: transparent;
     backdrop-filter: blur(12px);
    border: 1px solid rgba(55, 65, 81, 0.5);
      box-shadow: none;
      padding-top: 1rem;
      padding-bottom: 1rem;
    }
    100% {
      background: transparent;
      backdrop-filter: blur(12px);
      border: 1px solid rgba(229, 231, 235, 0.5);
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
      padding-top: 0.75rem;
      padding-bottom: 0.75rem;
    }
  }

  @media (min-width: 768px) {
    @keyframes blur {
      100% {
        width: 90%;
        left: 5%;
        border-radius: 9999px;
        background: transparent;
        backdrop-filter: blur(12px);
        border: 1px solid rgba(229, 231, 235, 0.5);
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
        padding-top: 0.75rem;
        padding-bottom: 0.75rem;
      }
    }
  }

  @media (prefers-color-scheme: dark) {
    @keyframes blur {
      100% {
        background: rgba(17, 24, 39, 0.8);
        backdrop-filter: blur(12px);
        border: 1px solid rgba(55, 65, 81, 0.5);
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
      }
    }
    @media (min-width: 768px) {
      @keyframes blur {
        100% {
          background: rgba(17, 24, 39, 0.8);
          backdrop-filter: blur(12px);
          border: 1px solid rgba(55, 65, 81, 0.5);
          box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
          border-radius: 9999px;
          width: 90%;
          left: 5%;
        }
      }
    }
  }

  /* Transiciones suaves */
  * {
    transition: background-color 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  /* Clase para link activo (opcional) */
  .nav-link-active {
    color: #4f46e5;
  }
  .dark .nav-link-active {
    color: #818cf8;
  }
  .nav-link-active::after {
    width: 100% !important;
  }

  /* Animación suave para el menú móvil */
  .ease-out-cubic {
    transition-timing-function: cubic-bezier(0.33, 1, 0.68, 1);
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const toggle = document.getElementById("menu-toggle");
    const menu = document.getElementById("mobile-menu");
    const overlay = document.getElementById("menu-overlay");
    const closeBtn = document.getElementById("close-menu");

    if (!toggle || !menu || !overlay || !closeBtn) return;

    const openMenu = () => {
      menu.hidden = false;
      setTimeout(() => {
        menu.classList.remove("translate-x-full");
      }, 10);
      toggle.setAttribute("aria-expanded", "true");
    };

    const closeMenu = () => {
      menu.classList.add("translate-x-full");
      setTimeout(() => {
        menu.hidden = true;
      }, 300);
      toggle.setAttribute("aria-expanded", "false");
    };

    toggle.addEventListener("click", (e) => {
      e.stopPropagation();
      const isExpanded = toggle.getAttribute("aria-expanded") === "true";
      isExpanded ? closeMenu() : openMenu();
    });

    overlay.addEventListener("click", closeMenu);
    closeBtn.addEventListener("click", closeMenu);

    const mobileLinks = menu.querySelectorAll("nav a");
    mobileLinks.forEach(link => {
      link.addEventListener("click", closeMenu);
    });

    const panel = menu.querySelector(".absolute.right-0");
    panel?.addEventListener("click", (e) => e.stopPropagation());
  });

  // Opcional: resaltar sección activa (igual que antes)
  document.addEventListener("astro:page-load", () => {
    const sections = document.querySelectorAll("section[id]");
    const navLinks = document.querySelectorAll("header nav a");

    if (!sections.length) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const id = entry.target.id;
            navLinks.forEach((link) => {
              const href = link.getAttribute("href");
              link.classList.remove("nav-link-active", "text-indigo-600", "dark:text-indigo-400");
              if (href?.includes(id)) {
                link.classList.add("nav-link-active", "text-indigo-600", "dark:text-indigo-400");
              }
            });
          }
        });
      },
      { rootMargin: "-20% 0px -35% 0px", threshold: 0.1 }
    );

    sections.forEach((section) => observer.observe(section));
  });
</script>