---
// Footer.astro - Versión Dark Mode
const currentYear = new Date().getFullYear();
const email = "haisiuleth@gmail.com";

const socialLinks = [
  {
    name: "LinkedIn",
    href: "https://www.linkedin.com/in/haisiuleth/",
    label: "Perfil de LinkedIn",
  },
  {
    name: "GitHub",
    href: "https://github.com/haisiuleth",
    label: "Perfil de GitHub",
  },
  {
    name: "Instagram",
    href: "https://www.instagram.com/haisiuleth/",
    label: "Perfil de Instagram",
  },
];
---

<footer class="relative mt-24 w-full border-t border-white/5 bg-gray-950/50">
  <!-- Gradiente decorativo superior - más sutil para dark mode -->
  <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-indigo-400/30 to-transparent" />
  
  <div class="max-w-[1120px] mx-auto px-4 md:px-6 py-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 md:gap-12">
      
      <!-- Columna 1: Marca personal -->
      <div class="md:col-span-2 space-y-4">
        <a href="/" class="inline-block">
          <h3 class="text-xl font-bold bg-gradient-to-r from-indigo-400 to-purple-400 bg-clip-text text-transparent">
            Haisiuleth
          </h3>
        </a>
        <p class="text-sm text-gray-400 max-w-sm leading-relaxed">
          Desarrolladora Full Stack y Consultora Funcional eCommerce especializada en 
          integraciones SAP, VTEX y AWS.
        </p>
        
        <!-- Badge de disponibilidad - dark mode -->
        <div class="flex items-center gap-2 pt-2">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400/50"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-green-400"></span>
          </span>
          <span class="text-xs text-gray-500">
            Disponible para nuevos retos
          </span>
        </div>
      </div>

      <!-- Columna 2: Navegación -->
      <div class="space-y-4">
        <h4 class="text-sm font-semibold text-white/90 uppercase tracking-wider">
          Navegación
        </h4>
        <ul class="space-y-2">
          <li>
            <a href="/#experiencia" class="text-sm text-gray-400 hover:text-indigo-400 transition-colors">
              Experiencia
            </a>
          </li>
          <li>
            <a href="/#proyectos" class="text-sm text-gray-400 hover:text-indigo-400 transition-colors">
              Proyectos
            </a>
          </li>
          <li>
            <a href="/#sobre-mi" class="text-sm text-gray-400 hover:text-indigo-400 transition-colors">
              Sobre mí
            </a>
          </li>
        </ul>
      </div>

      <!-- Columna 3: Contacto -->
      <div class="space-y-4">
        <h4 class="text-sm font-semibold text-white/90 uppercase tracking-wider">
          Contacto
        </h4>
        <ul class="space-y-2">
          <li>
            <a 
              href={`mailto:${email}`}
              class="text-sm text-gray-400 hover:text-indigo-400 transition-colors flex items-center gap-2 group"
            >
              <svg class="w-4 h-4 group-hover:text-indigo-400 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
              {email}
            </a>
          </li>
          
          <!-- Redes sociales - dark mode -->
          <li class="pt-2">
            <div class="flex items-center gap-4">
              {socialLinks.map((social) => (
                <a
         
                  href={social.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={social.label}
                  class="text-gray-500 hover:text-indigo-400 transition-all duration-300 hover:scale-110"
                >
                  <span class="sr-only">{social.name}</span>
                  <!-- Iconos con color ajustado para dark mode -->
                  {social.name === "LinkedIn" && (
                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451c.979 0 1.771-.773 1.771-1.729V1.729C24 .774 23.204 0 22.225 0z"/>
                    </svg>
                  )}
                  {social.name === "GitHub" && (
                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
                    </svg>
                  )}
                  {social.name === "Instagram" && (
                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.28-.059-1.69-.073-4.949-.073zM5.838 12a6.162 6.162 0 1112.324 0 6.162 6.162 0 01-12.324 0zM12 16a4 4 0 110-8 4 4 0 010 8zm4.965-10.405a1.44 1.44 0 112.881.001 1.44 1.44 0 01-2.881-.001z"/>
                    </svg>
                  )}
                </a>
              ))}
            </div>
          </li>
        </ul>
      </div>
    </div>

    <!-- Línea divisoria inferior -->
    <div class="mt-12 pt-8 border-t border-white/5">
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <!-- Copyright - dark mode -->
        <p class="text-xs text-gray-500">
          &copy; {currentYear} <span class="font-medium text-gray-400">Haisiuleth</span>. 
  

        <!-- Enlaces legales - dark mode -->
        <div class="flex items-center gap-4 text-xs">
          <a href="/#sobre-mi" class="text-gray-500 hover:text-indigo-400 transition-colors">
            Sobre mí
          </a>
          <span class="text-gray-600">|</span>
          <a href="mailto:haisiuleth@gmail.com" class="text-gray-500 hover:text-indigo-400 transition-colors">
            Contacto
          </a>
        </div>
      </div>
    </div>
  </div>
</footer>

<style>
  /* Animación sutil para el gradiente */
  @keyframes gradientFlow {
    0%, 100% { opacity: 0.3; }
    50% { opacity: 0.6; }
  }

  .animate-gradient {
    animation: gradientFlow 3s ease-in-out infinite;
  }
</style>