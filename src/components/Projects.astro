---
// Projects.astro - Opción 2: Cards Interactivas
const TAGS = {
  SAP: {
    name: "SAP",
    class: "bg-indigo-500/10 text-indigo-400 border border-indigo-500/20",
  },
  VTEX: {
    name: "VTEX",
    class: "bg-pink-500/10 text-pink-400 border border-pink-500/20",
  },
  AWS: {
    name: "AWS",
    class: "bg-orange-500/10 text-orange-400 border border-orange-500/20",
  },
  NODE: {
    name: "Node.js",
    class: "bg-green-500/10 text-green-400 border border-green-500/20",
  },
  REACT: {
    name: "React",
    class: "bg-sky-500/10 text-sky-400 border border-sky-500/20",
  },
  EMARSYS: {
    name: "Emarsys",
    class: "bg-purple-500/10 text-purple-400 border border-purple-500/20",
  },
};


const PROJECTS = [
  {
    title: "Portal B2B Integrado a SAP",
    company: "E-commerce B2B & Integraciones",
    description:
      "Desarrollo e integración de un portal B2B para facilitar la autogestión de clientes empresariales.",
    fullDescription:
      "Participé en el desarrollo de un portal B2B de autogestión integrado con SAP ERP, orientado a facilitar los procesos comerciales de clientes empresariales. Trabajé en tareas de desarrollo e integración utilizando React, Node.js y TypeScript, contribuyendo a funcionalidades relacionadas con pedidos, facturación y consulta de información comercial.",
    image: "/project.png",
    tags: [TAGS.REACT, TAGS.NODE, TAGS.AWS, TAGS.SAP],
    stats: [
      { label: "Tipo de solución", value: "Portal B2B" },
      { label: "Integración", value: "SAP ERP" },
      { label: "Enfoque", value: "Desarrollo e integración" },
    ],
    color: "from-indigo-500 to-blue-500",
  },
  {
    title: "Integraciones eCommerce & Salesforce",
    company: "Integración de Sistemas",
    description:
      "Integración de Salesforce con plataformas eCommerce y otros sistemas para facilitar el intercambio de información.",
    fullDescription:
      "Participé en desarrollos de integración entre Salesforce y otros sistemas, apoyando la comunicación y el intercambio de información entre plataformas. Mi experiencia se ha enfocado en el desarrollo técnico de integraciones y en la conexión de soluciones dentro de ecosistemas empresariales, contribuyendo a mejorar la continuidad de los flujos de información.",
    image: "/sso.png",
    tags: [TAGS.NODE, TAGS.AWS],
    stats: [
      { label: "Solución", value: "Integración de sistemas" },
      { label: "Plataformas", value: "Salesforce · eCommerce" },
      { label: "Enfoque", value: "Intercambio de datos" },
    ],
    color: "from-pink-500 to-purple-500",
  },
  {
    title: "Integración VTEX & Marketing Automation",
    company: "E-commerce & Marketing Automation",
    description:
      "Integración de 13 tiendas eCommerce con Emarsys para conectar datos y habilitar acciones de marketing automatizado.",
    fullDescription:
      "Participé en la integración de 13 tiendas eCommerce con Emarsys mediante Web Extend y herramientas de integración. El trabajo permitió conectar información relevante para iniciativas de marketing automation, como la captación de leads, el carrito abandonado y el comportamiento de navegación. También brindé acompañamiento técnico y capacitaciones a clientes para facilitar la configuración y el uso de las soluciones implementadas.",
    image: "/webExtend.png",
    tags: [TAGS.VTEX, TAGS.EMARSYS, TAGS.AWS, TAGS.NODE],
    stats: [
      { label: "Tiendas integradas", value: "13" },
      { label: "Plataformas", value: "VTEX · Emarsys" },
      { label: "Enfoque", value: "Integración y automatización" },
    ],
    color: "from-orange-500 to-red-500",
  },
  {
    title: "Consultoría & Automatización de Campañas",
    company: "Consultoría Funcional E-commerce",
    description:
      "Análisis funcional, configuración de herramientas y acompañamiento a clientes en soluciones de e-commerce y marketing automation.",
    fullDescription:
      "Participé en proyectos de consultoría funcional de e-commerce, combinando análisis de requerimientos, desarrollo técnico, configuración de plataformas y acompañamiento a clientes. Trabajé con herramientas como Emarsys y VTEX en iniciativas relacionadas con flujos automatizados, segmentación y campañas de marketing, apoyando la implementación de soluciones alineadas con las necesidades del negocio.",
    image: "/marketing.png",
    tags: [TAGS.EMARSYS, TAGS.VTEX, TAGS.SAP],
    stats: [
      { label: "Responsabilidad", value: "Consultoría funcional" },
      { label: "Implementación", value: "Configuración y desarrollo" },
      { label: "Enfoque", value: "E-commerce & CRM" },
    ],
    color: "from-purple-500 to-indigo-500",
  },
];

---

<div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
  {
    PROJECTS.map((project) => (
      <article
        class="group relative overflow-hidden rounded-3xl
             bg-white/5 backdrop-blur-sm
             border border-white/10
             hover:border-white/20
             transition-all duration-700
             hover:shadow-2xl hover:shadow-indigo-500/20
             hover:-translate-y-2"
      >
        {/* Gradiente de fondo animado */}
        <div
          class={`
        absolute inset-0 bg-gradient-to-br ${project.color} 
        opacity-0 group-hover:opacity-10 
        transition-opacity duration-700
      `}
        />

        {/* Línea superior decorativa */}
        <div
          class={`
        absolute top-0 left-0 right-0 h-1 
        bg-gradient-to-r ${project.color}
        transform scale-x-0 group-hover:scale-x-100
        transition-transform duration-700 origin-left
      `}
        />

        <div class="relative p-6 md:p-8">
          {/* Header con empresa */}
          <div class="flex items-start justify-between mb-6">
            <div>
              <span class="text-xs uppercase tracking-wider text-indigo-400 font-medium">
                {project.company}
              </span>
              <h3
                class="text-2xl md:text-3xl font-bold text-white mt-1
                       group-hover:translate-x-1 transition-transform duration-300"
              >
                {project.title}
              </h3>
            </div>

            {/* Icono de flecha animado */}
            <div
              class="w-10 h-10 rounded-full
                      bg-white/5 border border-white/10
                      flex items-center justify-center
                      group-hover:bg-indigo-500/20 group-hover:border-indigo-500/30
                      transition-all duration-300"
            >
              <svg
                class="w-5 h-5 text-indigo-400 
                        group-hover:translate-x-1 group-hover:-translate-y-1 
                        transition-transform duration-300"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M17 8l4 4m0 0l-4 4m4-4H3"
                />
              </svg>
            </div>
          </div>

          {/* Grid: Imagen + Stats */}
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
            {/* Imagen */}
            <div
              class="relative overflow-hidden rounded-xl
                      aspect-video md:aspect-square
                      border border-white/10
                      group/image"
            >
              <div
                class={`
              absolute inset-0 bg-gradient-to-br ${project.color} opacity-0
              group-hover/image:opacity-20 transition-opacity duration-500
            `}
              />
              <img
                src={project.image}
                alt={project.title}
                class="w-full h-full object-cover
                     transition-transform duration-1000
                     group-hover/image:scale-110"
                loading="lazy"
              />
            </div>

            {/* Stats Cards */}
            <div class="grid grid-cols-1 gap-3">
              {project.stats.map((stat) => (
                <div
                  class="p-4 rounded-xl
                          bg-white/5 backdrop-blur-sm
                          border border-white/10
                          group/stat
                          hover:bg-white/10
                          transition-all duration-300"
                >
                  <span class="text-xs text-gray-500 uppercase tracking-wider">
                    {stat.label}
                  </span>
                  <p
                    class="text-xl font-bold text-white
                          group-hover/stat:translate-x-1 transition-transform duration-300"
                  >
                    {stat.value}
                  </p>
                </div>
              ))}
            </div>
          </div>

          {/* Descripción corta */}
          <p
            class="text-gray-400 text-sm leading-relaxed mb-4
                  line-clamp-2 group-hover:line-clamp-none
                  transition-all duration-500"
          >
            {project.description}
          </p>

          {/* Tags */}
          <div class="flex flex-wrap gap-2 mb-6">
            {project.tags.map((tag) => (
              <span
                class={`
              px-3 py-1.5 rounded-full text-xs font-medium
              backdrop-blur-sm
              transition-all duration-300
              hover:scale-105
              ${tag.class}
            `}
              >
                {tag.name}
              </span>
            ))}
          </div>

          {/* Footer con acción */}
   <footer class="pt-4 border-t border-white/10">

  <details class="group text-sm">
    
    <summary class="flex items-center justify-between cursor-pointer text-indigo-400 font-medium">
      
      <span class="flex items-center gap-2 text-xs text-gray-500">
        <span class="w-1.5 h-1.5 bg-green-500 rounded-full animate-pulse" />
        Proyecto en producción
      </span>

      <span class="flex items-center gap-1">
        Saber más
        <svg
          class="w-4 h-4 transition-transform duration-300 group-open:rotate-90"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M9 5l7 7-7 7" />
        </svg>
      </span>

    </summary>

    <p class="mt-4 text-gray-400 leading-relaxed">
      {project.fullDescription}
    </p>

  </details>

</footer>

        </div>
      </article>
    ))
  }
</div>
